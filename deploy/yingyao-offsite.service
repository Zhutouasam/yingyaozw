[Unit]
Description=Yingyao Offsite website and pricing API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/yingyao-offsite/current
Environment=NODE_ENV=production
Environment=HOST=172.18.0.1
Environment=PORT=4173
Environment=PUBLIC_ORIGIN=https://yingyaozw.com
Environment=PRICING_DB_PATH=/opt/yingyao-offsite/data/pricing.sqlite
ExecStart=/usr/bin/node server/index.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/yingyao-offsite/data
PrivateTmp=true

[Install]
WantedBy=multi-user.target
